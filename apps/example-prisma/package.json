{
  "name": "@tenantry/example-prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal NestJS demo app showcasing @tenantry/core + @tenantry/prisma (per-tenant project management API).",
  "license": "MIT",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "dev": "pnpm build && node --watch dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@prisma/client": "^6.19.3",
    "@tenantry/core": "workspace:*",
    "@tenantry/prisma": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
