# Admin connection — used by `prisma migrate deploy` only.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenantry_example"

# Application connection — the API runs as a NON-superuser role so that
# Row-Level Security actually applies (superusers bypass RLS).
APP_DATABASE_URL="postgresql://app_user:app_password@localhost:5432/tenantry_example"

PORT=3000
