{
  "name": "@tenantry/prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma adapter for Tenantry: automatic tenant filtering via Prisma Client extensions, with hybrid and RLS-only PostgreSQL isolation modes.",
  "license": "MIT",
  "author": "devanonyme42",
  "homepage": "https://github.com/gettenantry/tenantry/tree/main/packages/prisma#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gettenantry/tenantry.git",
    "directory": "packages/prisma"
  },
  "bugs": {
    "url": "https://github.com/gettenantry/tenantry/issues"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "multi-tenancy",
    "multitenancy",
    "tenant",
    "saas",
    "row-level-security",
    "rls",
    "postgresql"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "prisma generate --schema test/integration/schema.prisma && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@tenantry/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@prisma/client": "^6.6.0",
    "@swc/core": "^1.15.46",
    "@testcontainers/postgresql": "^10.24.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "prisma": "^6.6.0",
    "tsup": "^8.4.0",
    "vitest": "^3.1.1"
  }
}
