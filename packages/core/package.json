{
  "name": "@tenantry/core",
  "version": "0.1.0",
  "private": true,
  "description": "ORM-agnostic multi-tenancy core for NestJS: tenant context (AsyncLocalStorage), extraction strategies, guards, decorators, and PostgreSQL RLS session management.",
  "license": "MIT",
  "author": "devanonyme42",
  "homepage": "https://github.com/gettenantry/tenantry/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gettenantry/tenantry.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gettenantry/tenantry/issues"
  },
  "keywords": [
    "nestjs",
    "multi-tenancy",
    "multitenancy",
    "tenant",
    "saas",
    "row-level-security",
    "rls",
    "postgresql",
    "async-local-storage"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.43",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.4.0",
    "vitest": "^3.1.1"
  }
}
